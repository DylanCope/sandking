{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    ".sandcastle/main.mts",
    ".sandcastle/*.mjs",
    "src/**/*.mts",
    "test/**/*.mts"
  ]
}
