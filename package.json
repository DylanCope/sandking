{
  "name": "sandking",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "bin": {
    "sandking": "./src/cli.mjs",
    "sandking-host": "./src/local-host.mjs"
  },
  "files": [
    "src/",
    ".sandcastle/",
    "README.md"
  ],
  "engines": {
    "node": ">=22.17.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "scripts": {
    "build:native-helpers": "node scripts/build-linux-process-tree-helpers.mjs --write",
    "check:native-helpers": "node scripts/build-linux-process-tree-helpers.mjs --check",
    "pretest": "node test/ensure-playwright.mjs",
    "sandcastle": "tsx .sandcastle/main.mts",
    "sandcastle:quick": "tsx .sandcastle/quick.mts",
    "cockpit": "node src/cli.mjs launch",
    "cockpit:stop": "node src/cli.mjs stop",
    "acceptance:issue-124:real": "node test/run-installed-claude-acceptance.mjs --issue 124",
    "acceptance:issue-146:real": "node test/run-issue-146-real-claude.mjs",
    "acceptance:issue-152:real": "node test/run-installed-claude-acceptance.mjs --issue 152",
    "acceptance:issue-174:real": "node test/run-issue-174-real-sandcastle.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.sandcastle.json && tsc --noEmit -p tsconfig.json",
    "test": "node --test .sandcastle/*.test.mjs test/*.test.mjs",
    "test:unit": "node --test .sandcastle/*.test.mjs $(ls test/*.test.mjs | grep -v '\\.browser\\.' | grep -Ev \"${SANDKING_UNIT_TEST_EXCLUDE:-^$}\")",
    "pretest:browser": "node test/ensure-playwright.mjs",
    "test:browser": "node --test test/*.browser.test.mjs"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "@lydell/node-pty": "1.2.0-beta.14",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@sparticuz/chromium": "^149.0.0",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "playwright": "^1.62.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
