{
  "name": "sandking",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "bin": {
    "sandking": "./src/cli.mjs",
    "sandking-host": "./src/local-host.mjs"
  },
  "files": [
    "src/",
    "README.md"
  ],
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "pretest": "node test/ensure-playwright.mjs",
    "sandcastle": "tsx .sandcastle/main.mts",
    "cockpit": "node src/cli.mjs launch",
    "cockpit:stop": "node src/cli.mjs stop",
    "acceptance:issue-117": "node test/run-issue-117-acceptance.mjs acceptance/issue-117.manifest.json",
    "acceptance:issue-117:update-evidence": "node test/run-issue-117-acceptance.mjs acceptance/issue-117.manifest.json --update-evidence",
    "acceptance:issue-118": "node test/run-issue-118-acceptance.mjs acceptance/issue-118.manifest.json",
    "acceptance:issue-118:update-evidence": "node test/run-issue-118-acceptance.mjs acceptance/issue-118.manifest.json --update-evidence",
    "acceptance:issue-123": "node test/run-issue-123-acceptance.mjs acceptance/issue-123.manifest.json",
    "acceptance:issue-123:update-evidence": "node test/run-issue-123-acceptance.mjs acceptance/issue-123.manifest.json --update-evidence",
    "typecheck": "tsc --noEmit -p tsconfig.sandcastle.json && tsc --noEmit -p tsconfig.json",
    "test": "node --test .sandcastle/*.test.mjs test/*.test.mjs"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.14",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@sparticuz/chromium": "^149.0.0",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "playwright": "^1.62.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
