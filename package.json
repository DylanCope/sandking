{
  "name": "sandking",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "bin": {
    "sandking": "./src/cli.mjs",
    "sandking-host": "./src/local-host.mjs"
  },
  "files": [
    "src/",
    ".sandcastle/",
    "README.md"
  ],
  "engines": {
    "node": ">=22.17.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "scripts": {
    "build:native-helpers": "node scripts/build-linux-process-tree-helpers.mjs --write",
    "check:native-helpers": "node scripts/build-linux-process-tree-helpers.mjs --check",
    "pretest": "node test/ensure-playwright.mjs",
    "sandcastle": "tsx .sandcastle/main.mts",
    "sandcastle:quick": "tsx .sandcastle/quick.mts",
    "cockpit": "node src/cli.mjs launch",
    "cockpit:stop": "node src/cli.mjs stop",
    "acceptance:issue-117": "node test/run-issue-117-acceptance.mjs acceptance/issue-117.manifest.json",
    "acceptance:issue-117:update-evidence": "node test/run-issue-117-acceptance.mjs acceptance/issue-117.manifest.json --update-evidence",
    "acceptance:issue-118": "node test/run-issue-118-acceptance.mjs acceptance/issue-118.manifest.json",
    "acceptance:issue-118:update-evidence": "node test/run-issue-118-acceptance.mjs acceptance/issue-118.manifest.json --update-evidence",
    "acceptance:issue-119": "node test/run-issue-119-acceptance.mjs acceptance/issue-119.manifest.json",
    "acceptance:issue-119:update-evidence": "node test/run-issue-119-acceptance.mjs acceptance/issue-119.manifest.json --update-evidence",
    "acceptance:issue-120": "node test/run-issue-120-acceptance.mjs acceptance/issue-120.manifest.json",
    "acceptance:issue-120:update-evidence": "node test/run-issue-120-acceptance.mjs acceptance/issue-120.manifest.json --update-evidence",
    "acceptance:issue-121": "node test/run-issue-121-acceptance.mjs acceptance/issue-121.manifest.json",
    "acceptance:issue-121:update-evidence": "node test/run-issue-121-acceptance.mjs acceptance/issue-121.manifest.json --update-evidence",
    "acceptance:issue-122": "node test/run-issue-122-acceptance.mjs acceptance/issue-122.manifest.json",
    "acceptance:issue-122:update-evidence": "node test/run-issue-122-acceptance.mjs acceptance/issue-122.manifest.json --update-evidence",
    "acceptance:issue-123": "node test/run-issue-123-acceptance.mjs acceptance/issue-123.manifest.json",
    "acceptance:issue-123:update-evidence": "node test/run-issue-123-acceptance.mjs acceptance/issue-123.manifest.json --update-evidence",
    "acceptance:issue-124": "node test/run-issue-124-acceptance.mjs acceptance/issue-124.manifest.json",
    "acceptance:issue-124:update-evidence": "node test/run-issue-124-acceptance.mjs acceptance/issue-124.manifest.json --update-evidence",
    "acceptance:issue-124:real": "node test/run-installed-claude-acceptance.mjs acceptance/issue-124.manifest.json",
    "acceptance:issue-146": "node test/run-issue-146-acceptance.mjs acceptance/issue-146.manifest.json",
    "acceptance:issue-146:update-evidence": "node test/run-issue-146-acceptance.mjs acceptance/issue-146.manifest.json --update-evidence",
    "acceptance:issue-146:real": "node test/run-issue-146-real-claude.mjs acceptance/issue-146.manifest.json",
    "acceptance:issue-149": "node test/run-issue-149-acceptance.mjs acceptance/issue-149.manifest.json",
    "acceptance:issue-149:update-evidence": "node test/run-issue-149-acceptance.mjs acceptance/issue-149.manifest.json --update-evidence",
    "acceptance:issue-152": "node test/run-issue-152-acceptance.mjs acceptance/issue-152.manifest.json",
    "acceptance:issue-152:update-evidence": "node test/run-issue-152-acceptance.mjs acceptance/issue-152.manifest.json --update-evidence",
    "acceptance:issue-152:real": "node test/run-installed-claude-acceptance.mjs acceptance/issue-152.manifest.json",
    "acceptance:issue-164": "node test/run-issue-164-acceptance.mjs acceptance/issue-164.manifest.json",
    "acceptance:issue-164:update-evidence": "node test/run-issue-164-acceptance.mjs acceptance/issue-164.manifest.json --update-evidence",
    "acceptance:issue-174": "node --test test/issue-174-acceptance-evidence.test.mjs",
    "acceptance:issue-174:real": "node test/run-issue-174-real-sandcastle.mjs acceptance/issue-174.manifest.json",
    "acceptance:issue-175": "node test/run-issue-175-acceptance.mjs acceptance/issue-175.manifest.json",
    "acceptance:issue-175:update-evidence": "node test/run-issue-175-acceptance.mjs acceptance/issue-175.manifest.json --update-evidence",
    "typecheck": "tsc --noEmit -p tsconfig.sandcastle.json && tsc --noEmit -p tsconfig.json",
    "test": "node --test .sandcastle/*.test.mjs test/*.test.mjs",
    "test:unit": "node --test .sandcastle/*.test.mjs $(ls test/*.test.mjs | grep -v '\\.browser\\.')",
    "pretest:browser": "node test/ensure-playwright.mjs",
    "test:browser": "node --test test/*.browser.test.mjs"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "@lydell/node-pty": "1.2.0-beta.14",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@sparticuz/chromium": "^149.0.0",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "playwright": "^1.62.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
